# Copy to .env.local and fill in.

# Required — Payload admin (/admin) needs a real Postgres database to run at
# all, and a secret for signing sessions/tokens. Any Postgres works (Vercel
# Postgres, Neon, Supabase, a plain server). Generate a secret with e.g.
# `openssl rand -base64 32`.
DATABASE_URL=
PAYLOAD_SECRET=

# Everything below is optional — each integration falls back to a stub /
# TBC placeholder until its key is set (see README.md).

# Stripe (USD / GBP checkout)
STRIPE_SECRET_KEY=

# Paystack (NGN checkout) — not wired up yet, Stripe-only for now
PAYSTACK_SECRET_KEY=

# Outbound email for booking confirmations, letter sign-ups, and the
# new-letter/new-product notifications sent to subscribers (Resend)
RESEND_API_KEY=
# "Display Name <email>" format is what shows as the sender in an inbox --
# defaults to "The Gentle Inspirer <info@gentleinspirer.com>" if left unset.
EMAIL_FROM="The Gentle Inspirer <info@gentleinspirer.com>"

# Optional — syncs subscribers to a Resend Audience so they can also be
# targeted by a Broadcast sent from Resend's own dashboard, not just the
# automated emails this site sends. Create an Audience in Resend
# (Audiences -> Create Audience) and paste its ID here; leave blank to skip
# the sync (subscribers still work, they just won't appear in Resend).
RESEND_AUDIENCE_ID=

# Used to build links inside subscriber emails (defaults to the production
# domain already, so this only needs setting for a staging/preview deploy)
SITE_URL=https://gentleinspirer.com

# Cal.com — booking availability + creation
CAL_API_KEY=
CAL_EVENT_TYPE_INTRO=
CAL_EVENT_TYPE_PAID=

# Media (/admin) uploads — Vercel's filesystem can't store uploaded files, so
# production needs Vercel Blob storage. In the Vercel dashboard: Storage tab
# -> Create Database -> Blob -> connect it to this project. It sets this env
# var automatically; you don't need to paste anything here for deployment.
# Local dev works without it (falls back to disk storage in ./media).
BLOB_READ_WRITE_TOKEN=
